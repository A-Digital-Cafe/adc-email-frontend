{
	"uiModule": {
		"enableSEO": true,
		"name": "adc-mail",
		"uiNamespace": "adc-platform",
		"uiName": "Correo",
		"framework": "react",
		"outputDir": "dist-ui",
		"isHost": true,
		"isRemote": false,
		"serviceWorker": true,
		"uiDependencies": ["adc-ui-library", "media-ui-library"],
		"devPort": 3030,
		"sharedLibs": ["react", "tailwind"],
		"i18n": true,
		"security": {
			"headers": {
				"Content-Security-Policy-Extend": "img-src https: blob:; media-src blob:; object-src blob:; frame-src blob:"
			}
		},
		"hosting": [
			{
				"domains": ["adigitalcafe.com"],
				"subdomains": ["email"]
			}
		],
		"federationExposes": {
			"./App": "./src/App.tsx"
		}
	},
	"services": [
		{
			"name": "EmailService",
			"version": "latest"
		},
		{
			"name": "IdentityManagerService",
			"version": "latest"
		},
		{
			"name": "SEOService",
			"version": "latest",
			"optional": true
		}
	]
}
